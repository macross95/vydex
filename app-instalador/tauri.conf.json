{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Instalador de Vydex",
  "version": "../app/package.json",
  "identifier": "com.vydex.instalador",
  "build": {
    "frontendDist": "../app/dist-instalador"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "publisher": "MacrosS",
    "copyright": "© 2026 MacrosS",
    "icon": [
      "../app/src-tauri/icons/icon.ico",
      "../app/src-tauri/icons/32x32.png",
      "../app/src-tauri/icons/128x128.png"
    ]
  }
}
