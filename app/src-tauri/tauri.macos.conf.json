{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vydex",
        "width": 1200,
        "height": 820,
        "minWidth": 480,
        "minHeight": 560,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0b0b0c",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ]
  },
  "bundle": {
    "targets": ["app", "dmg"],
    "resources": {
      "resources/bin-macos/": "bin/",
      "resources/licencias/": "licencias/"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
