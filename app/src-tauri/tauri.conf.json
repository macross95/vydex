{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vydex",
  "version": "../package.json",
  "identifier": "com.vydex.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vydex",
        "width": 1200,
        "height": 820,
        "minWidth": 480,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "shadow": true,
        "theme": "Dark",
        "backgroundColor": "#0b0b0c"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "MacrosS",
    "copyright": "© 2026 MacrosS",
    "category": "Video",
    "shortDescription": "Descarga video y audio en la máxima calidad",
    "longDescription": "Vydex descarga video hasta 8K y HDR, y audio en MP3, M4A u Opus, desde YouTube y más de 1.000 sitios.",
    "homepage": "https://www.linkedin.com/in/felipelucero/",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCODFGN0VEMTc2ODZDMUQKUldRZGJHZ1g3ZmVCMitNUDRtMTdHdDJkMTNoeHpKY2RTMkFCS2FPbGNadXlXOGJCME90UFNSQWsK",
      "endpoints": [
        "https://github.com/macross95/vydex/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
